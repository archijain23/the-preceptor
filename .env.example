# ─────────────────────────────────────────────────────────
# The Preceptor — Environment Variables
# Copy this to .env.local and fill in your values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────

# ── PHASE 1: Sanity CMS (content management) ─────────────
# Create a project at https://sanity.io
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# ── PHASE 2: Cal.com (booking calendar) ──────────────────
# Get your Cal.com username from https://cal.com/settings
VITE_CALCOM_USERNAME=your_calcom_username
VITE_CALCOM_EVENT_SLUG=astrology-consultation

# ── PHASE 3 (future): Email + Analytics ──────────────────
# VITE_RESEND_API_KEY=your_resend_api_key
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
